# =====================================================================
# Variables de entorno de la app. TODO lo variable va aquí; el código no tiene valores por defecto.
# Este archivo (.env) NO se sube a GitHub. La plantilla pública es .env.example.
# =====================================================================

# --- Marca y usuario que se muestran en la cabecera
APP_NAME=Portal de Siniestros
APP_TAGLINE=Seguros de viaje
APP_USER_NAME=Usuario Demo
APP_USER_ROLE=Gestor

# --- Servidor
HOST=127.0.0.1
PORT=5001               # el 5000 lo usa AirPlay Receiver en macOS
FLASK_DEBUG=1           # 1 = recarga automática y depurador; 0 en producción
MAX_RECLAMACIONES=100       # tope de reclamaciones que carga la app (y que genera el generador)
PER_PAGE_OPTIONS=10,25,50,100   # filas por página (la primera es la de por defecto)

# --- Archivos de datos (relativos a la carpeta del proyecto, o absolutos)
CLAIMS_FILE=data/claims.json
POLICIES_FILE=data/polizas.json
CLAUSES_FILE=data/clausulas.json
REVIEWS_FILE=data/revisiones.json       # resultado de cada revisión (se genera al usar la app)
CORRIDAS_FILE=data/corridas.jsonl       # historial de corridas para /estadisticas (se genera)

# --- Reglas de negocio que usa el agente
IMPORTE_ALTO_VALIDAR=10000       # desde este importe (€) una persona debe validar
PLAZO_RECLAMACION_DIAS=30        # días máximos entre el suceso y la reclamación

# --- Agente de revisión
AGENT_MODE=reglas               # reglas | ollama | claude | auto (claude si hay clave; si no, ollama si está configurado; si no, reglas)
AGENT_ARCH=lineas               # lineas (una consulta por línea) | una_llamada
AGENT_STEP_DELAY=0.5            # pausa (s) entre líneas en modo reglas, para ver cómo se marcan
AGENT_USER_AGENT=reclamaciones-agent/1.0

# --- Arquitecturas con framework (botones de la ficha). Dependencias: pip install -r requirements-extra.txt
LANGGRAPH_CONCURRENCIA=2         # líneas que LangGraph analiza a la vez (1 = una tras otra)
PYDANTIC_REINTENTOS=2            # reintentos de Pydantic AI si la salida no valida contra el esquema
PYDANTIC_AI_NO_BANNER=1          # silencia el banner que Pydantic AI imprime al crear un agente
CLAUDE_SDK_MAX_TURNOS=15         # tope de vueltas del Claude Agent SDK
CLAUDE_SDK_HERRAMIENTAS=Read,Grep   # herramientas que puede usar el Claude Agent SDK (solo lectura)

# --- LLM en Ollama (obligatorio si AGENT_MODE=ollama)
OLLAMA_URL=
OLLAMA_TOKEN=
OLLAMA_MODEL=
OLLAMA_TIMEOUT=120               # segundos por consulta
OLLAMA_MODELS_TIMEOUT=4          # segundos para listar los modelos del servidor
OLLAMA_MODELS_CACHE_SEG=600      # cuánto se recuerda la lista de modelos
OLLAMA_TEMPERATURE=0
OLLAMA_REINTENTOS=4              # reintentos si el servidor responde 429/502/503/504
OLLAMA_REINTENTO_SEG=5           # espera base (s) entre reintentos, si el servidor no indica Retry-After

# --- Claude (obligatorio si AGENT_MODE=claude; requiere pip install -U anthropic)
ANTHROPIC_API_KEY=
AGENT_MODEL=
AGENT_MAX_TOKENS=2000

# --- Benchmark (python bench.py): valores por defecto de sus argumentos
BENCH_N=10
BENCH_SEMILLA=1
# modelos separados por coma; si está vacío usa OLLAMA_MODEL
BENCH_MODELOS=
BENCH_ARQ=lineas,una_llamada
BENCH_REPETICIONES=1
BENCH_STEP_DELAY=0                  # pausa entre líneas en modo reglas al medir (0 = sin pausa)

# --- Generador de datos ficticios (python generate_data.py)
GEN_RECLAMACIONES=100
GEN_POLIZAS=120
GEN_SEMILLA=42
GEN_FECHA_REFERENCIA=2026-11-13      # «hoy» para decidir si una póliza está Vigente o Finalizada
GEN_FECHA_INICIO_VIAJES=2026-01-01
GEN_DIAS_VIAJES=270                  # los viajes empiezan en una ventana de estos días
