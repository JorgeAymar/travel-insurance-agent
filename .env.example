# Variables de entorno de la app (Portal de Reclamaciones de Seguros de Viaje)

# Servidor
HOST=127.0.0.1
PORT=5001            # 5000 lo usa AirPlay Receiver en macOS
FLASK_DEBUG=1        # 1 = recarga automática y depurador; 0 en producción

# Ficheros de datos (rutas absolutas o relativas a la carpeta del proyecto)
CLAIMS_FILE=data/claims.json
POLICIES_FILE=data/polizas.json
CLAUSES_FILE=data/clausulas.json

# Agente de revisión de reclamaciones
AGENT_MODE=ollama            # reglas | ollama | claude | auto
AGENT_MODEL=claude-opus-5-5   # modelo usado en modo claude
# ANTHROPIC_API_KEY=          # necesaria solo en modo claude (requiere también: pip install -U anthropic)
REVIEWS_FILE=data/revisiones.json

# LLM servido por Ollama (modo ollama)
OLLAMA_URL=
OLLAMA_TOKEN=
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_TIMEOUT=120
AGENT_STEP_DELAY=0.5   # pausa (s) entre líneas en el modo reglas, para ver cómo se marcan
